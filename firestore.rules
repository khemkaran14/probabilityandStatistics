rules_version = '2';

// Chance: each learner can read and write only their own document,
// users/{uid} = {
//   progress: { key: string, ... },
//   profile:  { name, email, phone, phoneVerified, photoUrl, marketingOptIn, consentAt },
//   updatedAt: timestamp
// }
// The email must be the one Google verified. A phone marked phoneVerified
// must be the one Firebase verified by SMS; otherwise (free plan, no SMS)
// it must at least look like an international mobile number.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(p) {
      return p is map
        && p.keys().hasOnly(['name', 'email', 'phone', 'phoneVerified', 'photoUrl', 'marketingOptIn', 'consentAt'])
        && p.name is string && p.name.size() <= 60
        && (p.phone == null
            || (p.get('phoneVerified', false) == true && p.phone == request.auth.token.get('phone_number', ''))
            || (p.get('phoneVerified', false) == false && p.phone is string && p.phone.matches('[+][1-9][0-9]{7,14}')))
        && (p.email == null || p.email == request.auth.token.get('email', ''))
        && (p.photoUrl == null || (p.photoUrl is string && p.photoUrl.size() <= 1000))
        && p.marketingOptIn is bool
        && (p.consentAt == null || p.consentAt is string);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['progress', 'profile', 'updatedAt'])
        && (!('progress' in request.resource.data)
            || (request.resource.data.progress is map && request.resource.data.progress.size() <= 20))
        && (!('profile' in request.resource.data) || validProfile(request.resource.data.profile));
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
